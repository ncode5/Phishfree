# ==============================================================================
# PhishFree Frontend Production Environment Configuration (.env)
# ==============================================================================

# Backend API Endpoint Base URL
#
# Scenario A: Separate Deployments (Frontend project + Backend project)
#   Set this to your live Vercel backend URL:
#   VITE_API_BASE_URL=https://phishfree-api.vercel.app/api/v1
#
# Scenario B: Unified Monorepo Deployment (Frontend + API in single project)
#   Leave blank or set to /api/v1 (relative path routing via vercel.json rewrites):
#   VITE_API_BASE_URL=/api/v1
#
# Scenario C: Local Development
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=https://phishfree-api.vercel.app/api/v1

# Backward/alternative alias supported by frontend API service:
VITE_API_URL=https://phishfree-api.vercel.app/api/v1
