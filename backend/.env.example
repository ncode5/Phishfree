# ==============================================================================
# PhishFree Backend Production Environment Configuration (.env)
# ==============================================================================

# Application Execution Environment
# Use 'production' on Vercel deployment. In production, dev tokens are suppressed,
# secure cookies are enforced, and strict security headers are applied.
ENVIRONMENT=production
PROJECT_NAME="PhishFree - Digital Trust Intelligence"

# Authentication & Cryptographic Session Security
# Generate a strong 256-bit secret key: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REMEMBER_ME_EXPIRE_DAYS=7
SESSION_COOKIE_NAME=phishfree_session
COOKIE_SAMESITE=lax
COOKIE_SECURE=True

# Database Configuration (PostgreSQL for Vercel Serverless)
# IMPORTANT: Vercel serverless functions have ephemeral, read-only filesystems.
# For persistent production user accounts, scans, and audit logs, supply a hosted
# PostgreSQL connection string with SSL enabled.
#
# Examples:
# Neon (Serverless Postgres with connection pooler):
#   DATABASE_URL=postgresql://user:password@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Supabase (Connection pooling port 6543 / 5432):
#   DATABASE_URL=postgresql://postgres.projectref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Fallback for local offline development:
#   DATABASE_URL=sqlite:///./trust_intel.db
DATABASE_URL=

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins. Supports wildcards (*.vercel.app)
# Example: https://phishfree.vercel.app,https://*.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://phishfree.vercel.app,https://*.vercel.app,http://localhost:5173

# External Threat Intelligence (VirusTotal v3 API)
# Optional: If omitted, the engine uses internal DNS, heuristics, and synthetic feeds.
VIRUSTOTAL_API_KEY=

# Generative AI Security Narrative (Google Gemini 1.5 Pro/Flash)
# Optional: If omitted, heuristic threat explanation templates are generated.
GEMINI_API_KEY=

# Web3 / Blockchain On-Chain Threat Registry (Ethereum Sepolia Testnet)
# RPC Provider URL: Infura, Alchemy, or PublicNode
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_CHAIN_ID=11155111

# Verified Deployed Smart Contract on Sepolia
CONTRACT_ADDRESS=0x535Dd5072d6c0de42167BaBe61c5cA880517f3F8
THREAT_REGISTRY_CONTRACT_ADDRESS=0x535Dd5072d6c0de42167BaBe61c5cA880517f3F8

# Relayer Wallet Private Key for committing cryptographic hashes on-chain
# REQUIRED ONLY for live write transactions. If omitted, on-chain reads remain live
# and mutations gracefully emulate transaction logs locally.
# NEVER commit private keys or expose them in client bundles!
PRIVATE_KEY=
BLOCKCHAIN_PRIVATE_KEY=
